pipeline {
  agent any

  parameters {
    booleanParam(name: 'PUSH_DOCKER_HUB', defaultValue: true, description: 'Construire et pousser l\'image sur Docker Hub')
    string(name: 'DOCKER_NAMESPACE', defaultValue: '', description: 'Namespace Docker Hub (vide = même nom que le login credential)')
  }

  options {
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
  }

  tools {
    maven 'Maven-3.9'
    jdk 'JDK-17'
  }

  environment {
    MAVEN_OPTS = '-Xmx1024m'
    MODULE_POM = 'alzheimer-system-main/backend/assistance quotidienne/pom.xml'
    DOCKER_IMAGE_REPO = 'alzheimer-assistance-quotidienne'
    DOCKERFILE_REL = 'alzheimer-system-main/backend/assistance quotidienne/Dockerfile'
    DOCKER_BUILD_DIR = 'alzheimer-system-main/backend/assistance quotidienne'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Assistance quotidienne — compilation') {
      steps {
        sh '''
          mvn -f "$MODULE_POM" clean compile -B
        '''
      }
    }

    stage('Assistance quotidienne — tests unitaires') {
      steps {
        sh '''
          mvn -f "$MODULE_POM" test -B
          mvn -f "$MODULE_POM" jacoco:report -B
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/surefire-reports/*.xml'
        }
      }
    }

    stage('Assistance quotidienne — package') {
      steps {
        sh '''
          mvn -f "$MODULE_POM" package -DskipTests -B
        '''
      }
    }

    stage('Assistance quotidienne — SonarQube') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh '''
            mvn -f "$MODULE_POM" org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar \
              -Dsonar.projectKey=alzheimer-assistance-quotidienne \
              -Dsonar.projectName='Assistance Quotidienne' \
              -Dsonar.java.source=17 \
              -Dsonar.coverage.jacoco.xmlReportPaths="${WORKSPACE}/alzheimer-system-main/backend/assistance quotidienne/target/site/jacoco/jacoco.xml" \
              -B
          '''
        }
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker Hub — build & push') {
      when {
        expression { params.PUSH_DOCKER_HUB != false }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-hub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh """
            set -e
            NS='${params.DOCKER_NAMESPACE}'
            if [ -z "\$NS" ]; then NS="\$DH_USER"; fi
            IMG="\$NS/${env.DOCKER_IMAGE_REPO}"
            echo "\$DH_PASS" | docker login -u "\$DH_USER" --password-stdin
            docker build -f '${env.DOCKERFILE_REL}' -t "\$IMG:${env.BUILD_NUMBER}" '${env.DOCKER_BUILD_DIR}'
            docker tag "\$IMG:${env.BUILD_NUMBER}" "\$IMG:latest"
            docker push "\$IMG:${env.BUILD_NUMBER}"
            docker push "\$IMG:latest"
            docker logout || true
          """
        }
      }
    }
  }

  post {
    failure {
      echo 'Pipeline Assistance quotidienne échouée — voir la console et SonarQube.'
    }
    success {
      echo 'Pipeline Assistance quotidienne réussie.'
    }
  }
}
