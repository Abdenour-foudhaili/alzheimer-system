pipeline {
  agent any

  parameters {
    booleanParam(name: 'PUSH_DOCKER_HUB', defaultValue: true, description: 'Construire et pousser l\'image sur Docker Hub')
    string(name: 'DOCKER_NAMESPACE', defaultValue: '', description: 'Namespace Docker Hub (vide = même nom que le login credential)')
  }

  options {
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
  }

  tools {
    jdk 'JDK-17'
    nodejs 'NodeJS-20'
  }

  environment {
    FRONTEND_DIR = 'alzheimer-system-main/frontend/alzheimer-angular'
    DOCKER_IMAGE_REPO = 'alzheimer-angular-front'
    DOCKERFILE_REL = 'alzheimer-system-main/frontend/alzheimer-angular/Dockerfile'
    DOCKER_BUILD_DIR = 'alzheimer-system-main/frontend/alzheimer-angular'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Frontend — dépendances (npm ci)') {
      steps {
        dir("${FRONTEND_DIR}") {
          sh 'npm ci'
        }
      }
    }

    stage('Frontend — tests unitaires') {
      steps {
        dir("${FRONTEND_DIR}") {
          sh '''
            set -e
            if [ -z "${CHROME_BIN:-}" ] || [ ! -x "${CHROME_BIN}" ]; then
              CHROME_BIN=""
              for c in /usr/bin/google-chrome-stable /usr/bin/google-chrome \\
                         /usr/bin/chromium /usr/bin/chromium-browser /snap/bin/chromium; do
                if [ -x "$c" ]; then CHROME_BIN="$c"; break; fi
              done
              export CHROME_BIN
            fi
            if [ -z "${CHROME_BIN:-}" ] || [ ! -x "$CHROME_BIN" ]; then
              echo "CHROME_BIN non défini ou inexécutable."
              echo "Sur l agent Debian/Ubuntu : sudo apt-get install -y chromium-browser"
              echo "(ou google-chrome-stable). Sinon définir CHROME_BIN dans le job Jenkins."
              exit 1
            fi
            export CHROME_BIN
            npm run test:ci
          '''
        }
      }
    }

    stage('Frontend — build production') {
      steps {
        dir("${FRONTEND_DIR}") {
          sh 'npm run build -- --configuration=production'
        }
      }
    }

    stage('Frontend — SonarQube') {
      steps {
        dir("${FRONTEND_DIR}") {
          withSonarQubeEnv('SonarQube') {
            sh '''
              sonar-scanner \
                -Dsonar.projectKey=alzheimer-angular \
                -Dsonar.projectName='Alzheimer Angular'
            '''
          }
        }
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker Hub — build & push') {
      when {
        expression { params.PUSH_DOCKER_HUB != false }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-hub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh """
            set -e
            NS='${params.DOCKER_NAMESPACE}'
            if [ -z "\$NS" ]; then NS="\$DH_USER"; fi
            IMG="\$NS/${env.DOCKER_IMAGE_REPO}"
            echo "\$DH_PASS" | docker login -u "\$DH_USER" --password-stdin
            docker build -f '${env.DOCKERFILE_REL}' -t "\$IMG:${env.BUILD_NUMBER}" '${env.DOCKER_BUILD_DIR}'
            docker tag "\$IMG:${env.BUILD_NUMBER}" "\$IMG:latest"
            docker push "\$IMG:${env.BUILD_NUMBER}"
            docker push "\$IMG:latest"
            docker logout || true
          """
        }
      }
    }
  }

  post {
    failure {
      echo 'Pipeline Frontend échouée — voir la console et SonarQube.'
    }
    success {
      echo 'Pipeline Frontend réussie.'
    }
  }
}
