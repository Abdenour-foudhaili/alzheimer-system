pipeline {
  agent any

  parameters {
    booleanParam(name: 'PUSH_DOCKER_HUB', defaultValue: true, description: 'Construire et pousser l\'image sur Docker Hub')
    string(name: 'DOCKER_NAMESPACE', defaultValue: '', description: 'Namespace Docker Hub (vide = même nom que le login credential)')
  }

  options {
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
  }

  tools {
    maven 'Maven-3.9'
    jdk 'JDK-17'
  }

  environment {
    MAVEN_OPTS = '-Xmx768m'
    MODULE_POM = 'alzheimer-system-main/backend/discovery-server/pom.xml'
    SONAR_PROJECT_KEY = 'alzheimer-eureka'
    SONAR_PROJECT_NAME = 'Eureka Discovery Server'
    DOCKER_IMAGE_REPO = 'alzheimer-eureka'
    DOCKERFILE_REL = 'alzheimer-system-main/backend/discovery-server/Dockerfile'
    DOCKER_CONTEXT = 'alzheimer-system-main/backend/discovery-server'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Eureka — compilation & tests') {
      steps {
        sh '''
          mvn -f "$MODULE_POM" clean verify -DskipTests=false -B
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/surefire-reports/*.xml'
        }
      }
    }

    stage('Eureka — SonarQube') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh '''
            mvn -f "$MODULE_POM" org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar \
              -Dsonar.projectKey=$SONAR_PROJECT_KEY \
              -Dsonar.projectName="$SONAR_PROJECT_NAME" \
              -Dsonar.java.source=17 \
              -B
          '''
        }
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker Hub — build & push') {
      when {
        expression { params.PUSH_DOCKER_HUB != false }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-hub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh """
            set -e
            NS='${params.DOCKER_NAMESPACE}'
            if [ -z "\$NS" ]; then NS="\$DH_USER"; fi
            IMG="\$NS/${env.DOCKER_IMAGE_REPO}"
            echo "\$DH_PASS" | docker login -u "\$DH_USER" --password-stdin
            docker build -f '${env.DOCKERFILE_REL}' -t "\$IMG:${env.BUILD_NUMBER}" '${env.DOCKER_CONTEXT}'
            docker tag "\$IMG:${env.BUILD_NUMBER}" "\$IMG:latest"
            docker push "\$IMG:${env.BUILD_NUMBER}"
            docker push "\$IMG:latest"
            docker logout || true
          """
        }
      }
    }
  }

  post {
    failure {
      echo 'Pipeline Eureka échouée — voir la console et SonarQube.'
    }
    success {
      echo 'Pipeline Eureka réussie.'
    }
  }
}
