// Tout-en-un Assistance + frontend. Voir Jenkinsfile.eureka, api-gateway, etc.
pipeline {
  agent any

  parameters {
    booleanParam(name: 'PUSH_DOCKER_HUB', defaultValue: true, description: 'Construire et pousser les images Assistance + Frontend sur Docker Hub')
    string(name: 'DOCKER_NAMESPACE', defaultValue: '', description: 'Namespace Docker Hub (vide = même nom que le login credential)')
  }

  options {
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
  }

  tools {
    maven 'Maven-3.9'
    jdk 'JDK-17'
    nodejs 'NodeJS-20'
  }

  environment {
    MAVEN_OPTS = '-Xmx1024m'
    BACKEND_POM = 'alzheimer-system-main/backend/assistance quotidienne/pom.xml'
    FRONTEND_DIR = 'alzheimer-system-main/frontend/alzheimer-angular'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Backend — build & tests') {
      steps {
        sh '''
          mvn -f "$BACKEND_POM" clean verify \
            -DskipTests=false \
            -B
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/surefire-reports/*.xml'
        }
      }
    }

    stage('Backend — SonarQube') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh '''
            mvn -f "$BACKEND_POM" sonar:sonar \
              -Dsonar.projectKey=alzheimer-assistance-quotidienne \
              -Dsonar.projectName='Assistance Quotidienne' \
              -Dsonar.java.source=17 \
              -Dsonar.coverage.jacoco.xmlReportPaths="${WORKSPACE}/alzheimer-system-main/backend/assistance quotidienne/target/site/jacoco/jacoco.xml" \
              -B
          '''
        }
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Frontend — install & build') {
      steps {
        dir("${FRONTEND_DIR}") {
          sh '''
            npm ci
            npm run test:ci
            npm run build -- --configuration=production
          '''
        }
      }
    }

    stage('Frontend — SonarQube') {
      steps {
        dir("${FRONTEND_DIR}") {
          withSonarQubeEnv('SonarQube') {
            sh '''
              sonar-scanner \
                -Dsonar.projectKey=alzheimer-angular \
                -Dsonar.projectName='Alzheimer Angular'
            '''
          }
        }
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker Hub — Assistance & Frontend') {
      when {
        expression { params.PUSH_DOCKER_HUB != false }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-hub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh """
            set -e
            NS='${params.DOCKER_NAMESPACE}'
            if [ -z "\$NS" ]; then NS="\$DH_USER"; fi
            echo "\$DH_PASS" | docker login -u "\$DH_USER" --password-stdin
            docker build -f 'alzheimer-system-main/backend/assistance quotidienne/Dockerfile' \
              -t "\$NS/alzheimer-assistance-quotidienne:${env.BUILD_NUMBER}" \
              'alzheimer-system-main/backend/assistance quotidienne'
            docker tag "\$NS/alzheimer-assistance-quotidienne:${env.BUILD_NUMBER}" "\$NS/alzheimer-assistance-quotidienne:latest"
            docker push "\$NS/alzheimer-assistance-quotidienne:${env.BUILD_NUMBER}"
            docker push "\$NS/alzheimer-assistance-quotidienne:latest"
            docker build -f 'alzheimer-system-main/frontend/alzheimer-angular/Dockerfile' \
              -t "\$NS/alzheimer-angular-front:${env.BUILD_NUMBER}" \
              'alzheimer-system-main/frontend/alzheimer-angular'
            docker tag "\$NS/alzheimer-angular-front:${env.BUILD_NUMBER}" "\$NS/alzheimer-angular-front:latest"
            docker push "\$NS/alzheimer-angular-front:${env.BUILD_NUMBER}"
            docker push "\$NS/alzheimer-angular-front:latest"
            docker logout || true
          """
        }
      }
    }

  }

  post {
    failure {
      echo 'Pipeline failed — vérifiez les logs et la Quality Gate SonarQube.'
    }
    success {
      echo 'Pipeline réussi.'
    }
  }
}
